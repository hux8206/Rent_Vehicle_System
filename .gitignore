# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Subpackage package-locks (Monorepo root manages dependencies)
apps/*/package-lock.json

# Build Outputs & Caches
dist/
**/dist/
.next/
**/.next/
out/
**/out/
build/
**/build/
*.tsbuildinfo
.turbo/
**/.turbo/
.swc/

# Testing
coverage/
*.lcov
test-results/
playwright-report/
bin/

# Environment & Secrets (Never commit secrets to GitHub)
.env*
!.env.example
**/.env*
!**/.env.example
*.pem
*.key
*.cert

# Local Media & Uploads (All media is served via Cloudinary)
apps/web/public/uploads/*
!apps/web/public/uploads/.gitkeep

# AI Agents & IDE Tooling
.agent/
.agents/
.codex/
.gemini/
.impeccable/
**/.impeccable/
.claude/
.cursor/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# OS & Temp
.DS_Store
Thumbs.db
*.tmp
*.temp

# IDE / Editor
.idea/
.vscode/*
!.vscode/extensions.json
