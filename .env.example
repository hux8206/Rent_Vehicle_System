# ==============================================================================
# Biến môi trường chung - VehicleRent Platform Monorepo
# ==============================================================================

# Khi chạy local với XAMPP / MySQL cục bộ:
DATABASE_URL="mysql://root:@localhost:3306/Rent_vehicle_system"
PORT=4000

# Khi chạy qua Docker Compose, các biến này được cấu hình tự động trong docker-compose.yml:
# DATABASE_URL="mysql://root:@mysql:3306/Rent_vehicle_system"
# NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# JWT Auth
JWT_SECRET=vehiclerent_super_secret_key_2026
JWT_EXPIRES_IN=7d

# Cổng thanh toán VietQR PayOS
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Cloudinary CDN Upload
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
