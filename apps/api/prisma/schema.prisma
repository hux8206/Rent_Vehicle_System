generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @db.VarChar(255)
  fullName       String   @db.VarChar(150)
  phone          String   @db.VarChar(20)
  role           Int      @default(2) // 0: Admin, 1: Partner, 2: Customer
  status         Boolean  @default(true)
  bankAccountNum     String?  @db.VarChar(50)
  bankName           String?  @db.VarChar(100)
  ownerPasswordHash  String?  @db.VarChar(255)
  createdAt      DateTime @default(now())

  stores              Store[]
  bookings            Booking[]
  partnerWallet       PartnerWallet?
  payoutRequests      PayoutRequest[]
  reviews             Review[]
  storeUpdateRequests StoreUpdateRequest[]

  @@map("users")
}

model Store {
  id           Int     @id @default(autoincrement())
  partnerId    Int
  storeName    String  @db.VarChar(255)
  province     String? @db.VarChar(100)
  address      String  @db.VarChar(500)
  phoneContact String  @db.VarChar(20)
  description  String? @db.Text
  storeImage   String? @db.VarChar(500)
  status       Int     @default(0) // 0: PENDING, 1: ACTIVE, 2: REJECTED
  rejectReason String? @db.VarChar(500)
  openTime     String? @default("07:00") @db.VarChar(10)
  closeTime    String? @default("21:00") @db.VarChar(10)

  partner       User           @relation(fields: [partnerId], references: [id])
  rentalPolicy  RentalPolicy?
  vehicleModels VehicleModel[]
  bookings      Booking[]
  reviews       Review[]
  updateRequests StoreUpdateRequest[]

  @@index([status, province])
  @@map("stores")
}

model RentalPolicy {
  id              Int     @id @default(autoincrement())
  storeId         Int     @unique
  depositPercent  Decimal @db.Decimal(5, 2)
  cancelRule      String? @db.Text
  refundCondition String? @db.Text

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("rental_policies")
}

model VehicleModel {
  id             Int     @id @default(autoincrement())
  storeId        Int
  name           String  @db.VarChar(255)
  brand          String  @db.VarChar(100)
  type           Int     // 0: Xe so, 1: Tay ga, 2: Con tay, 3: O to/Xe dien
  rentPrice      Decimal @db.Decimal(12, 2)
  specifications String? @db.Text
  images         Json?

  store          Store           @relation(fields: [storeId], references: [id])
  vehicleItems   VehicleItem[]
  bookingDetails BookingDetail[]

  @@index([storeId, type])
  @@map("vehicle_models")
}

model VehicleItem {
  id            Int     @id @default(autoincrement())
  modelId       Int
  licensePlate  String  @unique @db.VarChar(20)
  color         String? @db.VarChar(50)
  chassisNumber String? @db.VarChar(50)
  status        Int     @default(0) // 0: Available, 1: Reserved, 2: Rented, 3: Maintenance

  model          VehicleModel    @relation(fields: [modelId], references: [id])
  bookingDetails BookingDetail[]

  @@map("vehicle_items")
}

model Booking {
  id               Int       @id @default(autoincrement())
  bookingCode      String    @unique @db.VarChar(50)
  customerId       Int
  storeId          Int
  startTime        DateTime
  endTime          DateTime
  pickupType       Int       @default(0) // 0: AtStore, 1: Delivery
  deliveryAddress  String?   @db.VarChar(500)
  dayRent          Decimal   @db.Decimal(5, 2)
  rentAmount       Decimal   @db.Decimal(12, 2)
  depositAmount    Decimal   @db.Decimal(12, 2)
  commissionAmount Decimal   @db.Decimal(12, 2)
  holdExpiresAt    DateTime?
  status           Int       @default(0) // 0: PendingPayment, 1: Confirmed, 2: WaitingQueue, 3: ActiveRental, 4: Completed, 5: Cancelled
  createdAt        DateTime  @default(now())

  customer        User            @relation(fields: [customerId], references: [id])
  store           Store           @relation(fields: [storeId], references: [id])
  bookingDetails  BookingDetail[]
  payments        Payment[]
  review          Review?
  walletHistories WalletHistory[]

  @@index([status, holdExpiresAt])
  @@index([storeId, status, createdAt])
  @@map("bookings")
}

model BookingDetail {
  id            Int     @id @default(autoincrement())
  bookingId     Int
  modelId       Int
  vehicleItemId Int?
  quantity      Int     @default(1)
  pricePerUnit  Decimal @db.Decimal(12, 2)
  subTotal      Decimal @db.Decimal(12, 2)

  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  model       VehicleModel @relation(fields: [modelId], references: [id])
  vehicleItem VehicleItem? @relation(fields: [vehicleItemId], references: [id])

  @@map("booking_details")
}

model PartnerWallet {
  id          Int     @id @default(autoincrement())
  partnerId   Int     @unique
  balance     Decimal @default(0.00) @db.Decimal(12, 2)
  creditLimit Decimal @default(500000.00) @db.Decimal(12, 2)
  status      Int     @default(1)

  partner   User            @relation(fields: [partnerId], references: [id])
  histories WalletHistory[]

  @@map("partner_wallets")
}

model WalletHistory {
  id            Int      @id @default(autoincrement())
  walletId      Int
  bookingId     Int?
  type          Int      // 0: Deposit, 1: Commission_Deduction, 2: Refund
  amount        Decimal  @db.Decimal(12, 2)
  balanceBefore Decimal  @db.Decimal(12, 2)
  balanceAfter  Decimal  @db.Decimal(12, 2)
  description   String   @db.VarChar(255)
  createdAt     DateTime @default(now())

  wallet  PartnerWallet @relation(fields: [walletId], references: [id])
  booking Booking?      @relation(fields: [bookingId], references: [id])

  @@index([walletId, createdAt])
  @@map("wallet_histories")
}

model Payment {
  id             Int       @id @default(autoincrement())
  bookingId      Int
  transactionRef String    @unique @db.VarChar(100)
  paymentMethod  Int       @default(1) // 0: Cash, 1: BankTransfer/VietQR
  paymentType    Int       // 0: FullPayment, 1: DepositOnly
  amount         Decimal   @db.Decimal(12, 2)
  paymentStatus  Int       @default(0) // 0: Pending, 1: Success, 2: Failed
  paymentTime    DateTime?
  createdAt      DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Review {
  id           Int      @id @default(autoincrement())
  bookingId    Int      @unique
  customerId   Int
  storeId      Int
  rateStar     Int
  comment      String?  @db.Text
  isHidden     Boolean  @default(false)
  hiddenReason String?  @db.VarChar(255)
  createdAt    DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  customer User    @relation(fields: [customerId], references: [id])
  store    Store   @relation(fields: [storeId], references: [id])

  @@index([storeId, isHidden])
  @@map("reviews")
}

model SystemConfig {
  id                Int      @id @default(autoincrement())
  commissionRate    Decimal  @default(10.00) @db.Decimal(5, 2) // % hoa hồng sàn (mặc định 10%)
  creditLimit       Decimal  @default(500000.00) @db.Decimal(12, 2) // Hạn mức âm cho phép (mặc định 500k)
  minDepositPercent Decimal  @default(15.00) @db.Decimal(5, 2) // % cọc tối thiểu toàn hệ thống (mặc định 15%)
  updatedAt         DateTime @updatedAt

  @@map("system_configs")
}

model PayoutRequest {
  id             Int      @id @default(autoincrement())
  partnerId      Int
  amount         Decimal  @db.Decimal(12, 2)
  bankAccountNum String   @db.VarChar(50)
  bankName       String   @db.VarChar(100)
  accountHolder  String   @db.VarChar(150)
  status         Int      @default(0) // 0: PENDING, 1: APPROVED, 2: REJECTED
  note           String?  @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  partner User @relation(fields: [partnerId], references: [id])

  @@map("payout_requests")
}

model StoreUpdateRequest {
  id             Int      @id @default(autoincrement())
  storeId        Int
  partnerId      Int
  storeName      String   @db.VarChar(255)
  province       String?  @db.VarChar(100)
  address        String   @db.VarChar(500)
  phoneContact   String   @db.VarChar(20)
  description    String?  @db.Text
  storeImage     String?  @db.VarChar(500)
  depositPercent Decimal  @db.Decimal(5, 2)
  cancelRule     String?  @db.Text
  bankAccountNum String?  @db.VarChar(50)
  bankName       String?  @db.VarChar(100)
  openTime       String?  @db.VarChar(10)
  closeTime      String?  @db.VarChar(10)
  status         Int      @default(0) // 0: PENDING, 1: APPROVED, 2: REJECTED
  rejectReason   String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store   Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  partner User  @relation(fields: [partnerId], references: [id])

  @@map("store_update_requests")
}
